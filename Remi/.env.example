# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id

# BigQuery
BIGQUERY_DATASET=your_dataset
BIGQUERY_LOCATION=US

# Cloud Tasks
CLOUD_TASKS_QUEUE=remi-dispatch-queue
CLOUD_TASKS_LOCATION=us-central1
DISPATCHER_URL=https://remi-dispatcher-xxxxx.a.run.app/dispatch
DISPATCHER_SERVICE_ACCOUNT=dispatcher-sa@your-project.iam.gserviceaccount.com

# Application
NODE_ENV=development
LOG_LEVEL=info
WORKFLOW_TIMEOUT_MS=300000
CONVERSATION_TTL_MS=1800000
MAX_RECIPIENTS=10000
