# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=remi-dispatcher
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
CLOUD_TASKS_SERVICE_ACCOUNT=cloud-tasks-sa@your-project.iam.gserviceaccount.com

# Slack (read from Secret Manager in production)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Application
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
